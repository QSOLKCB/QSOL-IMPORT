{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/qsol-import-ark-cleanroom-receipt-1.json",
  "title": "QSOL-IMPORT ARK Clean-Room Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "authority",
    "record_class",
    "ark_contract_protocol",
    "thoth_policy_protocol",
    "ark_trial_id",
    "observation_trial_id",
    "observation_sha256",
    "execution_receipt_sha256",
    "model_execution_claimed",
    "t5_ai_reconstruction_implemented",
    "metrics",
    "clean_room",
    "transport_equivalence",
    "negative_space",
    "conformance_pass",
    "aggregate_score_emitted",
    "boundaries",
    "receipt_sha256"
  ],
  "properties": {
    "protocol": {"const": "QSOL-IMPORT/ARK-CLEANROOM-RECEIPT/1"},
    "schema_version": {"const": "1.0.0"},
    "authority": {"const": "measurement-contract-only"},
    "record_class": {"enum": ["synthetic-conformance", "externally-observed-clean-room"]},
    "ark_contract_protocol": {"const": "QSOL-ARK/PERSONAL-CONTINUITY/1"},
    "thoth_policy_protocol": {"const": "QSOL-THOTH/ARK-EVALUATION-POLICY/1"},
    "ark_trial_id": {"enum": ["P0", "P1", "P2", "P3"]},
    "observation_trial_id": {"type": "string", "minLength": 1},
    "observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "model_execution_claimed": {"type": "boolean"},
    "t5_ai_reconstruction_implemented": {"const": false},
    "metrics": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "status", "numerator", "denominator", "basis_points"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unassessed"]},
          "numerator": {"type": "integer", "minimum": 0},
          "denominator": {"type": "integer", "minimum": 0},
          "basis_points": {"type": ["integer", "null"]},
          "passed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "unassessed": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "clean_room": {"type": "object"},
    "transport_equivalence": {"type": "object"},
    "negative_space": {"type": "object"},
    "conformance_pass": {"type": "boolean"},
    "aggregate_score_emitted": {"const": false},
    "boundaries": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
