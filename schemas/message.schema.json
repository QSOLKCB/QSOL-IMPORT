    "source_node_index": {"type": "integer", "minimum": 0},
    "source_node_id": {"type": "string"},
    "conversation_id": {"type": ["string", "null"]},
    "conversation_title": {"type": ["string", "null"]},
    "source_message_id": {"type": ["string", "null"]},
    "parent_node_id": {"type": ["string", "null"]},
    "children_node_ids": {"type": "array", "items": {"type": "string"}},
    "author_role": {"type": ["string", "null"]},
    "author_name": {"type": ["string", "null"]},
    "create_time": {"type": ["number", "string", "null"]},
    "update_time": {"type": ["number", "string", "null"]},
    "status": {"type": ["string", "null"]},
    "recipient": {"type": ["string", "null"]},
    "content_type": {"type": ["string", "null"]},
    "message": {"type": "object"}
  },
  "additionalProperties": false
}
