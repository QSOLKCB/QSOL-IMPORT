{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/qsol-import-provenance-1.json",
  "title": "QSOL-IMPORT Provenance v1",
  "type": "object",
  "required": ["protocol", "adapter_protocol", "adapter_id", "source_vendor", "source_type", "source_path", "source_sha256", "size_bytes", "disposition", "reason"],
  "properties": {
    "protocol": {"const": "QSOL-IMPORT/PROVENANCE/1"},
    "adapter_protocol": {"const": "QSOL-IMPORT/ADAPTER/1"},
    "adapter_id": {"type": "string", "minLength": 1},
    "source_vendor": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "disposition": {"enum": ["normalized", "keep", "extract", "tombstone", "reject"]},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
