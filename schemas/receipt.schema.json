{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/qsol-import-receipt-1.json",
  "title": "QSOL-IMPORT Receipt v1",
  "type": "object",
  "required": ["protocol", "schema_version", "implementation_version", "source_type", "profile", "input_sha256", "policy_sha256", "implementation_sha256", "output_sha256", "candidate_sha256", "receipt_sha256", "conversations", "messages", "files_seen", "files_retained", "files_tombstoned", "files_rejected"],
  "properties": {
    "protocol": {"const": "QSOL-IMPORT/RECEIPT/1"},
    "schema_version": {"const": "1.0.0"},
    "implementation_version": {"type": "string"},
    "source_type": {"type": "string"},
    "profile": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conversations": {"type": "integer", "minimum": 0},
    "messages": {"type": "integer", "minimum": 0},
    "files_seen": {"type": "integer", "minimum": 0},
    "files_retained": {"type": "integer", "minimum": 0},
    "files_tombstoned": {"type": "integer", "minimum": 0},
    "files_rejected": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
